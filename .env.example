# ============================================================
# Environment variables (optional for future backend wiring)
# ============================================================
# This frontend demo does not require a .env file to run.
# Copy this file to .env.local when connecting a real API.

# Public site URL (used later for absolute OG tags / sitemap generation)
VITE_SITE_URL=https://example.com

# Future quotation API endpoint (not used in the demo build)
# VITE_QUOTE_API_URL=https://api.example.com/quotes

# WhatsApp business number digits only, e.g. 233241234567
# Prefer editing src/data/company.js for the demo; env can override later.
# VITE_WHATSAPP_NUMBER=
